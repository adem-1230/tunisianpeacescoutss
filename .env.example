DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# البريد الذي تصلك عليه رسائل الاستمارات (غيّره من إعدادات المنصة دون تعديل الكود)
CONTACT_EMAIL=you@example.com

# اختر أحد مساري الإرسال:
# 1) Resend
RESEND_API_KEY=
EMAIL_FROM=كشافة السلام <noreply@example.com>

# 2) SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=كشافة السلام <noreply@example.com>
